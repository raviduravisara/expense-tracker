rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidExpense(data) {
      return data.keys().hasOnly(['title', 'amount', 'category', 'date', 'note', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 50
        && data.amount is number && data.amount > 0 && data.amount <= 10000000
        && data.category in ['food', 'transport', 'shopping', 'bills', 'entertainment', 'health', 'education', 'other']
        && data.date is timestamp
        && data.createdAt is timestamp
        && (data.note == null || (data.note is string && data.note.size() <= 200));
    }

    match /users/{userId}/expenses/{expenseId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidExpense(request.resource.data);
    }
  }
}
